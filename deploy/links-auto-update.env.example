APP_DIR=/serverdata/wwwroot/links
STATE_DIR=/serverdata/deploy/links
NODE_BIN_DIR=/serverdata/runenv/node/bin
# Use the actual Nginx/PHP group and PHP-FPM systemd service name.
WEB_GROUP=www-data
PHP_FPM_SERVICE=php7.4-fpm
# Replace with your real HTTPS domain; certificate verification stays enabled.
HEALTH_URL=https://relations.example.com/api/health
